# -*- mode: ruby -*-
# vi: set ft=ruby :

ansible_groups = {
  "hosts" => ["windows", "controller"], 
  "routers" => [], 
  "ssh" => ["controller"], 
  "winrm" => ["windows"], 
  "ansible" => ["windows", "controller"]
}

Vagrant.configure("2") do |config|
  config.vm.boot_timeout = 9999

  # Device(host): windows
  config.vm.define "windows" do |device|
    device.vm.hostname = "windows"
    device.vm.box = "munikypo/windows-server-2019"
    device.vm.communicator = "winrm"
    device.ssh.username = "windows"
    device.winrm.username = "windows"
    device.winrm.password = "vagrant"
    device.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end
    device.vm.network "private_network",
      virtualbox__intnet: "network",
      ip: "10.10.30.6",
      netmask: "255.255.255.0"
  end

  # Device(host): controller
  config.vm.define "controller" do |device|
    device.vm.hostname = "controller"
    device.vm.box = "munikypo/debian-10"
    device.vm.provider "virtualbox" do |vb|
      vb.memory = 512
      vb.cpus = 2
    end
    device.vm.synced_folder ".",
      "/vagrant",
      type: "rsync",
      rsync__exclude: [".git/", "topology.yml", "patch.sh", "training.json"]
    device.vm.network "private_network",
      virtualbox__intnet: "network",
      ip: "10.10.30.5",
      netmask: "255.255.255.0"
    device.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "preconfig/playbook.yml"
      ansible.groups = ansible_groups
      ansible.limit = "controller"
      ansible.galaxy_role_file = "provisioning/requirements.yml"
      ansible.galaxy_roles_path = "provisioning/roles"
      ansible.galaxy_command = "sudo ansible-galaxy install --role-file=%{role_file} --roles-path=%{roles_path} --force"
    end
    device.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "preconfig/playbook.yml"
      ansible.groups = ansible_groups
      ansible.limit = "winrm"
      ansible.galaxy_role_file = "provisioning/requirements.yml"
      ansible.galaxy_roles_path = "provisioning/roles"
      ansible.galaxy_command = "sudo ansible-galaxy install --role-file=%{role_file} --roles-path=%{roles_path} --force"
    end
    device.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "provisioning/playbook.yml"
      ansible.groups = ansible_groups
      ansible.limit = "windows"
      ansible.galaxy_role_file = "provisioning/requirements.yml"
      ansible.galaxy_roles_path = "provisioning/roles"
      ansible.galaxy_command = "sudo ansible-galaxy install --role-file=%{role_file} --roles-path=%{roles_path} --force"
    end
  end
end
